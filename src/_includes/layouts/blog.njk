---
layout: layouts/base.njk
permalink: /blog/{{ page.fileSlug }}/ 
---

<div class="container">
  <article>
    <h1>{{ title }}</h1>

    <time class="post-date" datetime="{{ date | isoDate }}">
      {{ date | formatBlogDate }}
    </time>

    {% block content %}
      {{ content | safe }}
    {% endblock %}
  </article>
</div>